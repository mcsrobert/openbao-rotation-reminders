{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["openbao", "ntfy"],
  "definitions": {
    "duration": { "type": "string", "pattern": "^[0-9]+[hdw]$" },
    "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "maxLength": 253 },
    "url": { "type": "string", "pattern": "^https?://[^/?#@\\s]+(/[^?#\\s]*)?$" }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "schedule": { "type": "string", "minLength": 1 },
    "timeZone": { "type": "string" },
    "concurrencyPolicy": { "enum": ["Allow", "Forbid", "Replace"] },
    "startingDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "backoffLimit": { "type": "integer", "minimum": 0 },
    "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
    "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
    "suspend": { "type": "boolean" },
    "openbao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "mount"],
      "properties": {
        "address": { "$ref": "#/definitions/url" },
        "mount": { "type": "string", "pattern": "^/*([^/\\s.][^/\\s]*|\\.[^/\\s.][^/\\s]*|\\.\\.[^/\\s]+)(/([^/\\s.][^/\\s]*|\\.[^/\\s.][^/\\s]*|\\.\\.[^/\\s]+))*/*$" },
        "uiUrl": { "anyOf": [{ "const": "" }, { "type": "string", "pattern": "^https?://[^/?#@\\s]+([/?#]\\S*)?$" }] },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": { "type": "string" },
            "audience": { "type": "string", "minLength": 1 },
            "tokenExpirationSeconds": { "type": "integer", "minimum": 600 }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "caSecretName": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/name" }] },
            "caSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ntfy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": {
        "url": { "$ref": "#/definitions/url" },
        "existingSecret": { "$ref": "#/definitions/name" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "reminders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultWarnBefore": { "$ref": "#/definitions/duration" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "openbao": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "podSelector": { "type": "object" },
            "namespaceSelector": { "type": "object" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "extraEgress": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": {
      "type": "object",
      "propertyNames": { "not": { "enum": ["app.kubernetes.io/name", "app.kubernetes.io/instance"] } }
    },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
